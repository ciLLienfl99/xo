 def sign_macos_portable_tree(package_root: Path) -> None:
     """Sign each executable without sealing mutable portable storage in a bundle."""
-    for candidate in sorted(package_root.rglob("*")):
-        if is_macos_binary(candidate):
-            sign_macos_path(candidate)
+    # codesign promotes the main executable inside Contents/MacOS to its
+    # enclosing app when Info.plist is present, even if given the file path.
+    # Sign byte-identical standalone copies OUTSIDE that hierarchy, then copy
+    # the embedded Mach-O signatures back. Never seal the writable .app.
+    seal = package_root / "Contents" / "_CodeSignature"
+    if seal.exists():
+        raise RuntimeError(f"portable staging already has an outer resource seal: {seal}")
+    codesign = require_tool("codesign")
+    with tempfile.TemporaryDirectory(prefix="oxideterm-macho-sign-") as temporary:
+        for candidate in sorted(package_root.rglob("*")):
+            if is_macos_binary(candidate):
+                standalone = Path(temporary) / candidate.name
+                shutil.copy2(candidate, standalone)
+                command = macos_codesign_command(codesign, standalone)
+                command.remove("--deep")  # Individual Mach-O files, not bundles.
+                run(command)
+                run([codesign, "--verify", "--strict", "--verbose", str(standalone)])
+                shutil.copy2(standalone, candidate)
+                standalone.unlink()
+    if seal.exists():
+        raise RuntimeError(f"portable signing unexpectedly sealed the outer app: {seal}")
 
 
