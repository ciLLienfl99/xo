+def verify_macho_signature(path: Path) -> None:
+    """Verify the embedded signature, not an enclosing mutable app's resources.
+
+    codesign resolves an app's main-executable path back to its bundle. A
+    private standalone copy avoids that promotion without --ignore-resources
+    or changing the original file. This verifies integrity, not notarization
+    or the publisher's identity (portable development builds are ad-hoc).
+    """
+    require_real(path, directory=False)
+    with tempfile.TemporaryDirectory(prefix="oxideterm-macho-verify-") as temporary:
+        standalone = Path(temporary) / path.name
+        shutil.copyfile(path, standalone)
+        subprocess.run(
+            ["/usr/bin/codesign", "--verify", "--strict", str(standalone)],
+            check=True,
+        )
 
 
